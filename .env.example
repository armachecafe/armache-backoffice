# ============================================
# Backoffice Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git

# --- Cognito (Staff Pool) ---
NEXT_PUBLIC_BACKOFFICE_POOL_ID=us-east-1_XXXXXXXXX
NEXT_PUBLIC_BACKOFFICE_CLIENT_ID=your-backoffice-cognito-app-client-id-here

# --- API Gateway ---
NEXT_PUBLIC_API_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/prod
